# Database Connection Strings (Neon PostgreSQL)
# DATABASE_URL: connection pooled URL (used for application queries)
# DIRECT_URL: non-pooled URL (used for migrations)
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Next.js Application Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron API Secret Security (Used to secure the Vercel Cron endpoint)
CRON_SECRET="your-super-secure-cron-secret-key-here"
